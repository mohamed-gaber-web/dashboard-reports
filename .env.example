# Copy this file to `.env` (git-ignored). The dev API server (dev-api/server.js)
# and the serverless functions read these; secrets never reach the browser.

# D365 / Azure AD — client secret, injected server-side by /api/token.
AZURE_CLIENT_SECRET=your-azure-client-secret
# Optional overrides (defaults target the proven sandbox tenant):
# AZURE_TENANT_ID=26c58d65-b577-4f92-aed2-cec1395d146d
# AZURE_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token

# Second D365 source — Shatat UAT (Sha_SerialTrans). Selected by client_id in /api/token.
AZURE_CLIENT_SECRET_SHATAT=your-shatat-client-secret
# AZURE_TENANT_ID_SHATAT=be88f713-a964-488f-89ef-00a04bc0f789

# ── AI providers ───────────────────────────────────────────────────────────
# Both AI screens (AI Analyst, Chat Reports) can run on either provider, chosen
# from the model picker in the UI. Set at least ONE key; a provider with no key
# shows as unavailable in the picker rather than failing on the next question.

# Claude — the default. Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: pin a different model (default claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5
# Optional: reasoning depth vs latency — low|medium|high|xhigh|max (default medium).
# ANTHROPIC_EFFORT=medium

# Gemini — the alternative. Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a different model (default gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional: force the SERVER-SIDE default provider — anthropic|gemini. Without
# it, Claude wins when its key is present, else the first provider that has one.
# A request from the UI picker still overrides this.
# AI_PROVIDER=anthropic

# Optional: local dev API port (default 3001; must match proxy.conf.js).
# DEV_API_PORT=3001

# ---------------------------------------------------------------------------
# OPTION B — no local secrets. Point /api/* at your DEPLOYED Vercel app, which
# already holds the secrets in its environment. With this set you do NOT need
# AZURE_CLIENT_SECRET locally and do NOT need `npm run dev:api`.
# REMOTE_API_URL=https://<your-app>.vercel.app
